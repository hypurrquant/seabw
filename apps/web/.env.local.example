# HypurrQuant backbone — apps/server in worktree feat/seabw-integration
NEXT_PUBLIC_HQ_BASE_URL=http://localhost:3001

# Dev-mode bearer token. HQ accepts any non-empty token when
# AGENT_AUTH_DEV_BYPASS=1 is set on the HQ side.
NEXT_PUBLIC_HQ_DEV_BEARER=dev

# (optional) WalletConnect project id for wagmi
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
