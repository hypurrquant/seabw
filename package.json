{
  "name": "seabw",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @seabw/web run dev",
    "build": "pnpm --filter @seabw/web run build",
    "test": "pnpm --filter @seabw/web run test",
    "lint": "pnpm --filter @seabw/web run lint",
    "typecheck": "pnpm --filter @seabw/web exec tsc --noEmit",
    "test:e2e:manual": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.0",
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
  }
}
